{
 "seiten": {
  "kf3": "federgesetz",
  "ki3": "beschleunigung-ef",
  "ki4": "beschleunigung-ef",
  "st8": "ohm-kennlinie",
  "kf4": "masse-gewicht"
 },
 "regeln": {
  "beschleunigung-ef": {
   "weg": [
    ".bef-sim > .sim-hint",
    "#befFit .fpm-note"
   ],
   "hinweis": "Miss selbst: mindestens fünf Zeiten stoppen, dann die Steigung der t-v-Geraden bestimmen.",
   "maske": [
    {
     "sel": "#befALbl",
     "re": "^[\\d,]+ m\\/s²$",
     "flags": "",
     "mit": "verdeckt"
    },
    {
     "sel": "#befStatus",
     "re": "\\s*bei a = [\\d,]+ m\\/s²",
     "flags": "",
     "mit": ""
    },
    {
     "sel": "#befFit",
     "re": " · erwartet: [\\d,.]+",
     "flags": "g",
     "mit": ""
    },
    {
     "sel": "#befFit",
     "re": "&nbsp;·&nbsp; Literatur: [\\d,.]+",
     "flags": "g",
     "mit": ""
    },
    {
     "sel": "#befFit",
     "re": "<span class=\"fpm-badge [^\"]*\">Abweichung[^<]*<\\/span>",
     "flags": "g",
     "mit": ""
    },
    {
     "sel": "#befFit",
     "re": "a = [\\d,]+ m\\/s²",
     "flags": "g",
     "mit": "deine Fahrt"
    }
   ]
  },
  "federgesetz": {
   "weg": [
    ".fed-sim .fpm-grid .fpm-note",
    ".fed-sim > .sim-hint"
   ],
   "hinweis": "Miss selbst: mindestens fünf Messpunkte aufnehmen, dann in deiner Tabelle F : s ausrechnen.",
   "maske": [
    {
     "sel": ".fed-sim > .fpm-note",
     "re": "\\s*Ab zwei Punkten legt die Simulation[^<]*?Federhärte D\\.",
     "flags": "",
     "mit": " Ab zwei Punkten legt die Simulation die Ausgleichsgerade hindurch."
    },
    {
     "sel": "#fedStatus",
     "re": "\\s*·\\s*Ausgleichsgerade durch (\\d+) Punkte: <b>Steigung D = [^<]*<\\/b>",
     "flags": "",
     "mit": " · Ausgleichsgerade durch $1 Punkte"
    }
   ]
  },
  "ohm-kennlinie": {
   "weg": [
    ".ohg-sim .fpm-grid .fpm-note",
    ".ohg-sim > .sim-hint"
   ],
   "hinweis": "Miss selbst: fünf Spannungen einstellen, Messpunkte eintragen, dann U : I ausrechnen.",
   "maske": [
    {
     "sel": "#ohgRklein",
     "re": "^10 Ω$",
     "flags": "",
     "mit": "Draht A"
    },
    {
     "sel": "#ohgRgross",
     "re": "^20 Ω$",
     "flags": "",
     "mit": "Draht B"
    },
    {
     "sel": "#ohgStatus",
     "re": "\\s*·\\s*R = U\\/I = [\\d,.]+ Ω",
     "flags": "",
     "mit": ""
    },
    {
     "sel": "#ohgStatus",
     "re": "\\s*Widerstand fest: [\\d,.]+ Ω\\.",
     "flags": "",
     "mit": " Der Draht bleibt derselbe."
    },
    {
     "sel": "#ohgTable",
     "re": "<td>R = U\\/I<\\/td>",
     "flags": "",
     "mit": "<td>U : I</td>"
    }
   ]
  },
  "masse-gewicht": {
   "weg": [
    ".mgw-sim .fpm-grid .fpm-note",
    ".mgw-sim > .sim-hint",
    ".mgw-sim .ab-body"
   ],
   "maske": [
    {
     "sel": "#mgwStatus",
     "re": "<b>F = m · g = ",
     "mit": "<b>F = ",
     "flags": ""
    }
   ],
   "hinweis": "Miss selbst: drei Körper wählen, Masse und Kraft ablesen, dann F : m ausrechnen."
  }
 },
 "bedienung": {
  "federgesetz": "_fedSetFeder('weich'); _fedHaenge(100); _fedMessen(); _fedHaenge(100); _fedMessen();",
  "ohm-kennlinie": "_ohgSetR('klein'); _ohgU_(1); _ohgMessen(); _ohgU_(1); _ohgMessen();",
  "beschleunigung-ef": "_befSetA(2); _befMessen(); _befSetPreset(0);",
  "masse-gewicht": "_mgwSet(2); _mgwSet(3); _mgwSet(4);"
 }
}